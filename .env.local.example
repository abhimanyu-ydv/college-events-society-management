# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project settings -> Database -> Connection string (use the "Transaction" pooler URI)
DATABASE_URL=

# Comma-separated list of email domains allowed to sign in, e.g. "university.edu"
ALLOWED_EMAIL_DOMAIN=

# Resend (resend.com) — transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Inngest (inngest.com) — scheduled reminder emails.
# Local dev: set INNGEST_DEV=1 and run `npx inngest-cli dev` alongside `npm run dev`
# (without INNGEST_DEV=1, /api/inngest 500s — it assumes production/cloud mode by default).
# Production: leave INNGEST_DEV unset and fill in the two keys below instead.
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Groq (console.groq.com) — optional AI event-description drafting.
# Leave blank and the "Draft with AI" button just shows an error; the rest
# of the app doesn't depend on this.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
